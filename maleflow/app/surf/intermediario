<script>
document.addEventListener("DOMContentLoaded", () => {
  const itens = document.querySelectorAll("ul li");

  itens.forEach(li => {
    const match = li.innerText.match(/(\d+)\s*x\s*(\d+)/i);
    if (!match) return;

    const reps = parseInt(match[2]);
    let descanso = reps <= 8 ? "⏱️ Descanso: 90 s" :
                    reps <= 12 ? "⏱️ Descanso: 60 s" :
                                 "⏱️ Descanso: 45 s";

    if (!li.querySelector(".descanso")) {
      const span = document.createElement("span");
      span.className = "descanso";
      span.style.display = "block";
      span.style.fontSize = "0.9rem";
      span.style.color = "#4caf50";
      span.style.marginTop = "3px";
      span.innerText = descanso;
      li.appendChild(span);
    }
  });
});
</script>

